# Environment variables read by the scripts (export them in your shell; the
# scripts do not load .env files themselves). None are required to rebuild from
# an existing cache/.

# Optional free OpenAlex API key: raises the daily request budget and enables
# cursor paging (only needed by part1_collect_data.py / part1b_enrich_data.py).
OPENALEX_API_KEY=
# Optional contact e-mail for the OpenAlex "polite pool".
OPENALEX_MAILTO=
# Requests to keep in reserve before the scripts stop for the day (default 5).
OPENALEX_BUDGET_RESERVE=5

# Override for the deployed dashboard URL (default: the Netlify site in group10_common.py).
DASHBOARD_URL=
